flowchart TD
    subgraph Ingestion["1. Ingestion Layer"]
        SIEM["SIEM Webhook\n(Sentinel / Splunk / CrowdStrike)"]
        UI["SOC Analyst Web Console\n(React 18 + Vite)"]
    end

    subgraph Backend["2. Orchestration Core (FastAPI Async)"]
        AUTH["API Key Auth & Rate Limiting\n(X-API-Key / Request Validation)"]
