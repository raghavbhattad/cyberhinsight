flowchart TD
    subgraph Client["1. Client Interface"]
        UI["SOC Analyst Chat Console\n(React 18 + Vite · Claude-like UI)"]
        SIEM["SIEM Ingestion Webhook\n(Sentinel / Splunk / CrowdStrike)"]
    end

    subgraph Gateway["2. FastAPI Core & Intent Router"]
        AUTH["API Key Auth & Validation\n(MAX_INCIDENT_CHARS = 10,000)"]
        ROUTER["Intent Router\n(Deterministic Rules + LLM Fallback)"]
    end

    subgraph Handlers["3. Specialized Handlers"]
        INV["Investigate Handler\n(IOC Extraction · Campaign Linking · Triage)"]
        HIST["Ask History Handler\n(Strict Grounded Recall · No Invented Facts)"]
        TEACH["Teach Handler\n(Analyst Feedback & Priority Fact Retain)"]
        GEN["General Handler\n(Defensive Security Guidance)"]
    end

    subgraph Intelligence["4. Dual AI Engines"]
        subgraph Groq["Groq High-Throughput Inference"]
            LLM_JSON["Structured JSON Analysis\n(Validation & Error-Recovery Retry)"]
            LLM_STREAM["Real-Time Token Streaming\n(Markdown Generation)"]
        end

        subgraph Hindsight["Hindsight Cloud Persistent Memory"]
            RECALL["arecall()\n(Semantic & Keyword Retrieval · Scores)"]
            RETAIN["aretain()\n(Incident & Outcome Tags · Document Upsert)"]
            REFLECT["areflect()\n(Organizational Playbook Synthesis)"]
        end
    end

    subgraph Storage["5. Persistence"]
        CHAT_STORE["Chat Store\n(Atomic File JSON · 20-Turn Cap)"]
        INC_STORE["Incident Store\n(Auditable Triage Records)"]
    end

    %% Data Flow
    UI -->|POST /api/chat & /api/chat/stream| AUTH
    SIEM -->|POST /api/ingest/alert| AUTH
    AUTH --> ROUTER

    ROUTER -->|intent: investigate| INV
    ROUTER -->|intent: ask_history| HIST
    ROUTER -->|intent: teach| TEACH
    ROUTER -->|intent: general| GEN

    INV -->|Recall Precedents| RECALL
    INV -->|Analyze Triage| LLM_JSON
    INV -->|Retain Investigation| RETAIN
    INV --> INC_STORE

    HIST -->|Retrieve Relevant Memories| RECALL
    HIST -->|Synthesize Grounded Answer| LLM_STREAM

    TEACH -->|Retain Outcome / Note| RETAIN

    GEN -->|Guidance Query| LLM_STREAM

    INV & HIST & TEACH & GEN --> CHAT_STORE
    CHAT_STORE -->|Stream SSE / Final Response| UI
    RETAIN -.->|Enriches Future Queries| RECALL
